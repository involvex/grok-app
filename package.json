{
  "name": "grok-app",
  "private": true,
  "version": "0.2.15",
  "description": "Desktop workbench for Grok Build CLI (English-first)",
  "author": "RongleCat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RongleCat/grok-app.git"
  },
  "homepage": "https://github.com/RongleCat/grok-app",
  "bugs": {
    "url": "https://github.com/RongleCat/grok-app/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.0",
  "scripts": {
    "preinstall": "bun scripts/check-deps-hygiene.mjs --preinstall",
    "deps:check": "bun scripts/check-deps-hygiene.mjs",
    "audit:prod": "bun pm audit --prod --audit-level moderate",
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 host",
    "build:ui": "tsc -b && vite build",
    "build:mac": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 mac",
    "build:mac-arm": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 mac-arm",
    "build:mac-intel": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 mac-intel",
    "build:mac-all": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 all-mac",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 win",
    "build:linux": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 linux",
    "build:all": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 all",
    "build:help": "powershell -ExecutionPolicy Bypass -File scripts/build-local.ps1 help",
    "setup:cross": "powershell -ExecutionPolicy Bypass -File scripts/setup-cross-compile.ps1",
    "release:tag": "powershell -ExecutionPolicy Bypass -File scripts/release-tag.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "chatcut:start": "bun scripts/chatcut-plugin-start.mjs",
    "chatcut:fetch": "bun scripts/chatcut-plugin-start.mjs --fetch"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@tabler/icons-react": "^3.45.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.47",
    "pdfjs-dist": "^5.4.296",
    "plyr": "^3.8.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "use-stick-to-bottom": "^1.1.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "canvas": "^3.2.3",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "mermaid": ">=11.16.1"
    }
  },
  "overrides": {
    "mermaid": ">=11.16.1"
  },
  "workspaces": [
    "."
  ],
  "trustedDependencies": [
    "@swc/core",
    "canvas",
    "core-js",
    "esbuild"
  ]
}
